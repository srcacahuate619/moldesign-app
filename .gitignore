data/pose_selector_dataset/v2/

data/molflex_caja/

data/molflex_reinicios/

# Geometria cruda y logs de las corridas con retencion forense (MF-33-B-RET-*).
# NO se borran del disco: la retencion es obligacion del prerregistro. Se excluyen del
# historial por tamano -35 MB solo en R1- y siguen siendo verificables porque cada
# registro de per_pose/ lleva el raw_sha256 de su PDBQT. Ver MF-33-B-RET-R1/RETENCION.md
scripts/artifacts_science/MF-33-B-RET-R*/raw_pdbqt/
scripts/artifacts_science/MF-33-B-RET-R*/logs/
scripts/artifacts_science/MF-33-PB/_rec/

# Estructuras originales descargadas de RCSB (REC-12-R1). 39 MB de terceros,
# reproducibles: files.rcsb.org/download/<pid>.pdb, y REC-12-R1 registra la fuente.
data/rcsb/

# Basura de pruebas con mocks sin configurar: un `MagicMock` sin `.return_value`
# se interpola en una ruta y crea directorios con su repr
# (`get_settings().vina_temp_dir`). Ni versionarlos ni empaquetarlos.
backend/MagicMock/
**/MagicMock/

# Salidas de Playwright: la build que consume el navegador y los diagnósticos
# (trazas, capturas) que deja al fallar. Son artefactos de una ejecución, no del
# producto, y `test-results/` puede llevar capturas de pantalla con datos.
frontend/.next-e2e/
frontend/test-results/
frontend/playwright-report/

# ── Artefactos de auditoría y de OTROS productos ────────────────────────────
#
# `.hallmark/` lo escribe la rúbrica de diseño al auditar una pantalla: es
# evidencia de una revisión, no parte del producto, y no debe entrar ni en el
# repositorio ni en el instalador.
.hallmark/

# En esta carpeta han aparecido artefactos de LegalDesk —otro producto—:
# routers `.damaged`, binarios de terceros (cloudflared, tesseract, poppler) y
# una SQLite con datos. Se movieron fuera del repositorio el 2026-08-31; el
# patrón queda para que no vuelvan a colarse en un `git add .`.
legaldesk-*/
*.damaged

# Salidas de ejecucion y de QA visual. `output/pytest-*` son directorios
# temporales que pytest dejo atras (SQLite de cohortes y receptores
# preparados); `output/pdf/` son PDF/PNG regenerables desde la suite de
# dossier. Nada de esto describe el producto: se reconstruye ejecutandolo.
output/

# Registro local de skills de la herramienta de desarrollo: contiene rutas
# personales de la maquina del mantenedor.
.atl/

# ── Restos de depuracion a mano en la raiz ────────────────────────────
# Trece archivos (`_bad.json`, `_t.json`, `_pf3_out.json`...) y el cache de
# resultados de vitest estaban VERSIONADOS: 874 KB de entradas y salidas de
# pruebas manuales, en la primera pantalla que ve quien abre el repositorio.
# No son evidencia de nada -los artefactos sellados viven en
# `scripts/artifacts_science/`- y hacen que el arbol parezca abandonado.
/_*.json
.vite/

# Worktrees locales de agentes; nunca forman parte del producto.
.worktrees/

