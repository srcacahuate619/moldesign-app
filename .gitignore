# ============================================================================
# MolDesign Build — .gitignore
# Basado en moldesign-app/.gitignore + extensiones para el fork desktop.
# Foco: mantener el repo liviano (~100-300MB) y NUNCA subir secrets ni assets
# pesados (modelos, DLLs, build artifacts).
# ============================================================================

# ── Secrets ────────────────────────────────────────────────────────────
# Los .env con secrets reales NUNCA se suben. Solo los .env.example van al repo.
.env
.env.*
!.env.example
!.env.desktop.example
!.env.local.example

# Otros archivos sensibles
*.pem
*.key
secret_key
git-credentials
.envrc
provider_config.json
moldesign_local.db
moldesign_local.db-*
molecular_design.db
molecular_design.db-*

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
build/
dist/
develop-eggs/
.downloads/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.python-version
Pipfile.lock
poetry.lock
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ── Node / Next.js ─────────────────────────────────────────────────────
node_modules/
.npm
.pnp.*
.yarn/
frontend/.next/
# Directorio de trabajo del servidor de desarrollo. Separado de `.next`
# para que `next dev` y `next build` no se bloqueen el mismo archivo.
frontend/.next-dev/
frontend/out/
frontend/.next/cache/
frontend/.next/trace
frontend/trace
frontend/.pytest_cache/
frontend/tsconfig.tsbuildinfo
*.webpack.hot-update.*
frontend/static/webpack/

# ── Tauri / Rust build artifacts ──────────────────────────────────────
# CRÍTICO: el build_tree de Cargo duplica site-packages enteros (C3 del
# informe de eficiencia). Excluir TODO el target/月至.
frontend/src-tauri/target/
frontend/src-tauri/gen/
frontend/src-tauri/resources/

# ── Python embedded (generado por bundle.py, no source) ──────────────
python-embed/

# ── Modelos GGUF y artefactos pesados de build ────────────────────────
# Los modelos se descargan on-demand vía launcher (Roadmap.md). Nunca al repo.
models/
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# ── Binarios externos descargables (Vina, xTB) ────────────────────────
# Estos binarios se descargan desde sus repos oficiales (Scripps, xtb-org)
# en el bundle script. No son source, son dependencias binarias.
tools/vina/*.exe
tools/vina/**/*
tools/xtb/
tools/xtb-*/
tools/llama/
tools/**/*.exe
tools/**/*.dll

# El conjunto app-local de MSVC es pequeño, firmado y gobernado por un manifiesto.
# Se versiona para que el instalador no dependa de Visual Studio en la máquina de build.
!tools/vc-runtime/
!tools/vc-runtime/**
tools/**/*.so
tools/**/*.dylib
tools/**/*.a
tools/**/*.lib

# Open Babel es un programa independiente GPL-2.0-only que MolDesign invoca por
# subproceso. Sus bytes se materializan desde el wheel `openbabel-wheel` con
# `scripts/stage_openbabel_tool.py`, igual que Vina y xTB se traen de su origen.
# Lo que SI se versiona de esa carpeta -y por eso las excepciones- es lo que
# convierte al binario en un componente auditable: el manifiesto con versión,
# hashes y procedencia, el texto integro de la GPLv2 y las instrucciones para
# obtener el código fuente correspondiente. Sin ellos, la carpeta seria un
# binario opaco y la obligación de la GPL quedaría fuera del repositorio.
tools/openbabel/bin/
# El codigo fuente correspondiente de Open Babel: acompana al BINARIO
# dentro del MSIX (GPL-2.0 sec. 3a), y el binario no viaja en git, asi que
# tampoco su fuente. 36,7 MB que no aportan nada al repositorio.
tools/openbabel/*.tar.gz
!tools/openbabel/openbabel-manifest.json
!tools/openbabel/LICENSE-GPL-2.0.txt
!tools/openbabel/README-PROCEDENCIA.md

# ── Data pesada regenerable (PDBs de targets, seed SQLite) ─────────────
# Los PDBs se descargan vía download_missing_pdbs.py. molgraph_seed.db es un
# SQLite binario que se regenera. mantenedor: el CSV + JSON de metadata
# (curated_targets.csv/.json en raíz) van al repo porque son catalogs curados.
data/targets/*.pdb
data/target_library/
data/pdbbind/
data/molgraph_seed.db
data/*.db
data/checkpoint_*.json
data/benchmark_checkpoint_*.json
data/ef_report_*.json
data/multitarget/
# PDB/PDBQT de targets en raíz (descargados vía RCSB u OpenBabel dependiendo
# del target) — ver scripts/benchmark_ef_vina.py para reproducir
data/*.pdb
data/*.pdbqt
# Datasets crudos (ChEMBL / DUD-E). Se pueden regenerar copiando de
# moldesign-app/data/multitarget/<name>/{actives.txt,decoys.smi} o descargando
# desde ChEMBL/DUD-E siguiendo scripts/download_missing_pdbs.py
data/chembl_*_actives.txt
data/dude_*_decoys.smi
# Carpeta tmp de la app (artefactos runtime: PDBQT temporales, etc.)
tmp/
# Output de smokes y runs full-scale (logs del bucket de benchmark)
logs/full_*.log
logs/full_*.err
logs/full_summary_*.json
logs/orchestrator_*.log
logs/orchestrator_*.err
logs/smoke_*.log
logs/smoke_*.err

# Artefactos del dist/ (instaladores previos)
dist/
*.zip
*.7z
*.tar.gz
# El código fuente GPL de Open Babel que acompaña a su binario (SOURCE-OFFER.json):
# sin él, un fork no pasa check:openbabel-fuente (medido el 2026-09-24).
!tools/openbabel/openbabel-src-*.tar.gz
!tools/openbabel/openbabel-wheel-recipe-*.tar.gz
scratch/

# Crash dumps y binaries
*.dmp
crash_dumps/

# ── IDE / Editor ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.bash_history
.vs/
*.user

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs y crash dumps ────────────────────────────────────────────────
*.log
# Los logs de un experimento sellado son activos con SHA-256 en su manifest:
# sin versionarlos, `validate` falla en un clon limpio (visto el 2026-09-23).
!scripts/artifacts_science/*/logs/*.log
*.err
*.out
dev-*.log
dev-*.out
stderr.log
stdout.log
backend.log
backend.err
backend.out
crash_dumps/

# ── Backend dev artifacts (logs del servicio local) ──────────────────
backend/dev-backend.err
backend/dev-backend.out
backend/dev-err.log
backend/dev-out.log
backend/backend.log

# ── SQLite local DBs (generados en runtime) ────────────────────────────
backend/moldesign_local.db
backend/moldesign_local.db-wal
backend/moldesign_local.db-shm
backend/molecular_design.db*
backend/*.db
backend/*.db-wal
backend/*.db-shm

# ── Rescoring cache y artifacts pesados (regenerables) ───────────────
rescoring/feature_cache_v4/
rescoring/trained_models/*.pth
rescoring/data/
rescoring/artifacts/*.joblib
rescoring/artifacts/*.pt
!rescoring/artifacts/gnn_v2_cl_best.pt
!rescoring/artifacts/contrastive_v31_pretrained.pt
rescoring/artifacts/*.npz
rescoring/*.log
rescoring/stderr.log
rescoring/stdout.log

# (OJO: rescoring/artifacts/*.json y .metadata.json SÍ van al repo —
#  son configs y metadatas que documentan los modelos, no pesos.)

# ── OS-specific Python venvs si existen colgados ──────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Backups locales accidentales (no subir backups del propio repo) ───
app_backup_*/
backend/services/chemistry/chemistry/
**/app_backup_*/
**/*_backup_*/

# ── Tauri capabilities / settings generados ──────────────────────────
frontend/src-tauri/gen/schemas/

# ── ESMFold cache interno si se replica ────────────────────────────────
esmfold/.cache/
esmfold-pro/.cache/

# ── Temporales del launcher ───────────────────────────────────────────
*.part
*.download
*.tmp
app_backup_*/
chemistry/chemistry/
services/chemistry/chemistry/

# Backups locales de stacking weights (generados por optimize-stacking-weights.py)
rescoring/artifacts/*.json.bak*
rescoring/artifacts/*.bak*


# Backups de curated_targets.csv (de focused-box et al)
curated_targets.csv.bak*

# ── CSP build artifacts (auto-generados por scripts/set-prod-csp.js) ──
frontend/src-tauri/tauri.conf.json.backup


