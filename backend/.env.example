# ============================================================================
# MolDesign Backend — .env.example
# Copia este archivo a .env y completa los valores necesarios.
# NUNCA subas el .env real a git (lo excluye el .gitignore).
# ============================================================================

# === Aplicación ===
ENVIRONMENT=development
LOG_LEVEL=INFO
# SECRET_KEY: se autogenera en ~/.moldesign/secret_key en modo desktop.
# Déjalo vacío DESKTOP o usa `python -c "import os; print(os.urandom(32).hex())"`
SECRET_KEY=

# === AutoDock Vina ===
# Ruta absoluta al binario vina.exe (Windows) o vina (Linux/macOS).
VINA_EXECUTABLE_PATH=

# === Solana Blockchain (certificación opcional) ===
# SOLO si usás el módulo de certificación on-chain. Dejar vacío en desktop local.
SOLANA_RPC_URL=

# === Google OAuth (login social — opcional en desktop) ===
# Generá tus credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# IMPORTANTE: rotá este client secret si lo cambiaste alguna vez a mano.
GOOGLE_CLIENT_SECRET=

# === Otros providers de IA ===
# Las API keys de IA (Gemini, Anthropic, OpenAI, Groq) NO van acá.
# Se configuran vía la interfaz de MolChat (Configuración > Interprete IA)
# y se guardan cifradas en ~/.moldesign/provider_config.json
