# ============================================================================
# MolDesign Frontend (Next.js) — .env.local.example
# Copia este archivo a .env.local y completa los valores necesarios.
# NUNCA subas el .env.local real a git (lo excluye el .gitignore).
# ============================================================================

# URL del backend FastAPI (modo desarrollo)
NEXT_PUBLIC_API_URL=http://localhost:8010

# NextAuth config — generá NEXTAUTH_SECRET con:
#   openssl rand -base64 32
# o en PowerShell:
#   [Convert]::ToBase64String([byte[]](1..32 | %{ Get-Random -Maximum 255 }))
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (debe matchear con backend/.env.GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
